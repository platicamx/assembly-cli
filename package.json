{
	"name": "@platicamx/assembly-cli",
	"version": "0.2.0",
	"description": "Create, deploy and manage Assembly apps (SvelteKit + Supabase on Cloud Run).",
	"license": "UNLICENSED",
	"type": "module",
	"bin": {
		"assembly": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/platicamx/assembly-cli.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && chmod +x dist/index.js",
		"dev": "node --experimental-strip-types src/index.ts",
		"check": "tsc -p tsconfig.json --noEmit",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"typescript": "~5.9"
	}
}
